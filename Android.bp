package {
    default_applicable_licenses: ["external_pffft_license"],
}

license {
    name: "external_pffft_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0","SPDX-license-identifier-BSD","SPDX-license-identifier-MIT","legacy_notice"],
    license_text: ["LICENSE.txt"],
}

cc_library_static {
    name: "libpffft",
    // vendor needed for libpreprocessing effects.
    vendor: true,
    srcs: [
        "pffft.c",
        "pffft_common.c",
    ],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    host_supported: true,
    visibility: ["//external/webrtc:__subpackages__"],
    cflags: [
        "-Wno-#pragma-messages",
    ],
    arch: {
        arm: {
            cflags: ["-DPFFFT_ENABLE_NEON"],
        },
        arm64: {
            cflags: ["-DPFFFT_ENABLE_NEON"],
        },
    },
}
